name: Run Jest Tests

# Kích hoạt workflow này khi có code được push lên nhánh main
on:
  push:
    branches:
      - main
  # Có thể thêm pull_request nếu bạn muốn chạy test khi có PR vào main
  # pull_request:
  #   branches:
  #     - main

jobs:
  test:
    # Chạy trên hệ điều hành Ubuntu mới nhất
    runs-on: ubuntu-latest

    steps:
      # Bước 1: Tải code từ repository về máy ảo
      - name: Checkout code
        uses: actions/checkout@v4

      # Bước 2: Cài đặt Node.js (sử dụng phiên bản LTS)
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20' # Bạn có thể đổi thành 18 hoặc phiên bản LTS khác
          cache: 'npm' # Giúp tăng tốc độ cài đặt bằng cách cache npm

      # Bước 3: Cài đặt các dependencies (như Jest)
      - name: Install dependencies
        run: npm ci # Tương đương npm install nhưng tối ưu hơn cho môi trường CI

      # Bước 4: Chạy Unit Test bằng Jest
      - name: Run tests
        run: npm test
